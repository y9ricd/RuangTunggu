# ─── RuangTunggu API Keys ─────────────────────────────────────────────────────
# Copy this file to local.properties and fill in your actual API keys.
# DO NOT commit local.properties to version control.
#
# Alternatively, you can set these in your gradle.properties (user-level)
# located at ~/.gradle/gradle.properties
# ──────────────────────────────────────────────────────────────────────────────

# Supabase project URL (e.g., https://xxxxx.supabase.co)
SUPABASE_URL=

# Supabase anonymous/public key
SUPABASE_ANON_KEY=

# Google reCAPTCHA Enterprise site key
RECAPTCHA_SITE_KEY=

# Google Maps API key
GOOGLE_MAPS_API_KEY=

# Android SDK location (auto-generated by Android Studio)
# sdk.dir=C\:\\Users\\YourUser\\AppData\\Local\\Android\\Sdk
